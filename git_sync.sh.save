dd```bash
#!/bin/bash

# ============================================================
# git_sync.sh
# Sincronização entre ambiente local e GitHub
# ============================================================

set -e

# ============================================================
# CORES
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============================================================
# FUNÇÕES
# ============================================================

erro() {
    echo -e "${RED}ERRO:${NC} $1"
    exit 1
}

info() {
    echo -e "${BLUE}==>${NC} $1"
}

ok() {
    echo -e "${GREEN}OK:${NC} $1"
}

aviso() {
    echo -e "${YELLOW}ATENÇÃO:${NC} $1"
}

mostrar_ajuda() {
    echo
    echo "Uso:"
    echo
    echo "  ./git_sync.sh"
    echo "      Sincronização segura."
    echo
    echo "  ./git_sync.sh --push"
    echo "      Adiciona, cria commit e envia para o GitHub."
    echo
    echo "  ./git_sync.sh --stash"
    echo "      Guarda alterações no stash e atualiza do GitHub."
    echo
    echo "  ./git_sync.sh --force"
    echo "      DESCARTA alterações locais e sincroniza com GitHub."
    echo
    echo "  ./git_sync.sh --help"
    echo "      Mostra esta ajuda."
    echo
}

tem_alteracoes() {
    if ! git diff --quiet; then
        return 0
    fi

    if ! git diff --cached --quiet; then
        return 0
    fi

    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        return 0
    fi

    return 1
}

mostrar_status() {
    echo
    echo "Alterações locais:"
    echo
    git status --short
    echo
}

# ============================================================
# PARÂMETROS
# ============================================================

MODO="safe"

case "${1:-}" in

    "")
        MODO="safe"
        ;;

    --push)
        MODO="push"
        ;;

    --stash)
        MODO="stash"
        ;;

    --force)
        MODO="force"
        ;;

    --help|-h)
        mostrar_ajuda
        exit 0
        ;;

    *)
        erro "Parâmetro inválido: $1"
        ;;

esac

# ============================================================
# VERIFICA REPOSITÓRIO
# ============================================================

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    erro "Este diretório não é um repositório Git."
fi

REPO_DIR=$(git rev-parse --show-toplevel)

cd "$REPO_DIR"

BRANCH=$(git branch --show-current)

if [ -z "$BRANCH" ]; then
    erro "Não foi possível identificar a branch atual."
fi

REMOTE=$(git remote get-url origin 2>/dev/null || true)

if [ -z "$REMOTE" ]; then
    erro "O remote 'origin' não está configurado."
fi

# ============================================================
# CABEÇALHO
# ============================================================

echo
echo "============================================================"
echo "             SINCRONIZAÇÃO COM GITHUB"
echo "============================================================"
echo
echo -e "Diretório : ${CYAN}$REPO_DIR${NC}"
echo -e "Branch    : ${CYAN}$BRANCH${NC}"
echo -e "Remote    : ${CYAN}$REMOTE${NC}"
echo -e "Modo      : ${CYAN}$MODO${NC}"
echo

# ============================================================
# FETCH
# ============================================================

info "Consultando o GitHub..."

git fetch origin

ok "Informações atualizadas."

# ============================================================
# VERIFICA BRANCH REMOTA
# ============================================================

if ! git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    erro "A branch origin/$BRANCH não existe."
fi

# ============================================================
# MODO PUSH
# ============================================================

if [ "$MODO" = "push" ]; then

    info "Modo PUSH."

    if ! tem_alteracoes; then
        aviso "Não existem alterações locais para enviar."
        exit 0
    fi

    mostrar_status

    # Verifica se o GitHub possui commits novos
    ATRAS=$(git rev-list --count "$BRANCH..origin/$BRANCH")

    if [ "$ATRAS" -gt 0 ]; then
        erro "O GitHub possui commits novos. Execute primeiro:

    ./git_sync.sh

ou:

    ./git_sync.sh --stash"
    fi

    echo
    read -rp "Mensagem do commit: " MENSAGEM

    if [ -z "$MENSAGEM" ]; then
        erro "A mensagem do commit não pode ser vazia."
    fi

    echo
    info "Adicionando alterações..."

    git add .

    echo
    info "Criando commit..."

    git commit -m "$MENSAGEM"

    echo
    info "Enviando para o GitHub..."

    git push origin "$BRANCH"

    echo
    ok "Push realizado com sucesso."

    exit 0
fi

# ============================================================
# MODO STASH
# ============================================================

if [ "$MODO" = "stash" ]; then

    info "Modo STASH."

    if tem_alteracoes; then

        mostrar_status

        info "Guardando alterações..."

        git stash push -u -m "git_sync"

        ok "Alterações guardadas no stash."

    else

        info "Não existem alterações locais."

    fi

    # Verifica commits locais ainda não enviados
    A_FRENTE=$(git rev-list --count "origin/$BRANCH..$BRANCH")

    if [ "$A_FRENTE" -gt 0 ]; then
        aviso "Existem commits locais que ainda não foram enviados ao GitHub."
        echo
        echo "Use:"
        echo
        echo "    git push origin $BRANCH"
        exit 1
    fi

    # Atualiza
    ATRAS=$(git rev-list --count "$BRANCH..origin/$BRANCH")

    if [ "$ATRAS" -gt 0 ]; then

        info "Atualizando código..."

        git pull --ff-only origin "$BRANCH"

        ok "Código atualizado."

    else

        ok "Código já está atualizado."

    fi

    echo
    echo "As alterações estão no stash."
    echo
    echo "Para consultar:"
    echo "    git stash list"
    echo
    echo "Para recuperar:"
    echo "    git stash pop"
    echo

    exit 0
fi

# ============================================================
# MODO FORCE
# ============================================================

if [ "$MODO" = "force" ]; then

    echo
    aviso "MODO FORCE"
    echo
    echo "Todas as alterações locais serão DESCARTADAS."
    echo
    echo "A cópia ficará exatamente igual a:"
    echo
    echo "    origin/$BRANCH"
    echo

    if tem_alteracoes; then
        mostrar_status
    fi

    read -rp "Digite SINCRONIZAR para continuar: " CONFIRMACAO

    if [ "$CONFIRMACAO" != "SINCRONIZAR" ]; then
        echo
        echo "Operação cancelada."
        exit 0
    fi

    echo
    info "Descartando alterações..."

    git reset --hard "origin/$BRANCH"

    echo
    info "Removendo arquivos não rastreados..."

    git clean -fd

    echo
    ok "Cópia sincronizada com o GitHub."

    exit 0
fi

# ============================================================
# MODO SAFE
# ============================================================

if [ "$MODO" = "safe" ]; then

    info "Modo seguro."

    # --------------------------------------------------------
    # Alterações não commitadas
    # --------------------------------------------------------

    if tem_alteracoes; then

        mostrar_status

        aviso "Não vou sobrescrever suas alterações locais."
        echo
        echo "Você pode:"
        echo
        echo "  --push"
        echo "      ./git_sync.sh --push"
        echo
        echo "  --stash"
        echo "      ./git_sync.sh --stash"
        echo
        echo "  --force"
        echo "      ./git_sync.sh --force"
        echo

        exit 1
    fi

    # --------------------------------------------------------
    # Commits locais não enviados
    # --------------------------------------------------------

    A_FRENTE=$(git rev-list --count "origin/$BRANCH..$BRANCH")

    if [ "$A_FRENTE" -gt 0 ]; then

        aviso "Existem $A_FRENTE commit(s) locais ainda não enviados."

        echo
        echo "Para enviar:"
        echo
        echo "    git push origin $BRANCH"
        echo

        exit 1
    fi

    # --------------------------------------------------------
    # Commits novos no GitHub
    # --------------------------------------------------------

    ATRAS=$(git rev-list --count "$BRANCH..origin/$BRANCH")

    if [ "$ATRAS" -gt 0 ]; then

        info "O GitHub possui $ATRAS commit(s) novos."

        info "Atualizando..."

        git pull --ff-only origin "$BRANCH"

        ok "Código atualizado."

    else

        ok "Sua cópia já está sincronizada com o GitHub."

    fi

fi

# ============================================================
# VALIDAÇÃO FINAL
# ============================================================

echo
echo "============================================================"
echo "                 VALIDAÇÃO FINAL"
echo "============================================================"
echo

git status

LOCAL=$(git rev-parse HEAD)
REMOTO=$(git rev-parse "origin/$BRANCH")

echo
echo "Commit local : $LOCAL"
echo "Commit GitHub: $REMOTO"
echo

if [ "$LOCAL" = "$REMOTO" ]; then

    echo "============================================================"
    echo -e "${GREEN}REPOSITÓRIO SINCRONIZADO${NC}"
    echo "============================================================"
    echo

    git log -1 --oneline

else

    echo "============================================================"
    echo -e "${RED}REPOSITÓRIO NÃO ESTÁ SINCRONIZADO${NC}"
    echo "============================================================"

    exit 1
fi
```
