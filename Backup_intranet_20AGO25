<style type="text/css">
  /* =============================
         ANIMAÇÕES
         ============================= */

  /* Animação de entrada da janela do chat
         - Desliza de baixo para cima com efeito de fade-in */
  @keyframes slideFadeIn {
    0% {
      transform: translateY(40px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Animação de entrada de mensagens enviadas pelo bot
         - Movimento da esquerda para a posição final com fade-in */
  @keyframes messageInLeft {
    0% {
      transform: translateX(-30px);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  /* Animação de entrada de mensagens enviadas pelo usuário
         - Movimento da direita para a posição final com fade-in */
  @keyframes messageInRight {
    0% {
      transform: translateX(30px);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }
  /* Widget Botão */
  #chatbot-widget {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background-image: url("https://transfer.sede.embrapa.br/transfer/cst/chatbot/flora2025/Flora_Widget_003.png");
    background-size: cover;
    background-position: center;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(0, 51, 102, 0.4);
    z-index: 9999;
    border: 2px solid #003366;
  }

  /* Tela de Boas-Vindas*/
  #welcome-screen {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 545px;
    max-height: 628px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 0 24px rgba(0, 51, 102, 0.25);
    padding: 20px;
    z-index: 10000;
    font-family: "Segoe UI", sans-serif;
    display: none;
    border: 1px solid #003366;
    animation: slideFadeIn 0.4s ease-out;
  }

  /* Container do Chat */
  #chat-container {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 585px;
    max-height: 628px;
    background-color: #e6f0f7;
    border-radius: 14px;
    display: none;
    flex-direction: column;
    overflow: hidden;
    z-index: 9999;
    color: #001a33;
    border: 1px solid #003366;
    box-shadow: 0 0 20px rgba(0, 51, 102, 0.3);
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    animation: slideFadeIn 0.4s ease-out;
  }

  #chat-header {
    background: linear-gradient(to right, #3797f7, #001a33);
    color: #ffffff;
    padding: 14px;
    font-weight: 600;
    font-size: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #003366;
  }

  #chat-header img {
    height: 36px;
    margin-right: 10px;
  }

  #close-btn {
    cursor: pointer;
    font-size: 22px;
    color: #ffffff;
  }

  #chat-body {
    padding: 12px;
    height: 468px;
    overflow-y: auto;
    background-color: #ffffff;
  }

  .message {
    margin: 10px 0;
    padding: 10px 14px;
    border-radius: 12px;
    max-width: 80%;
    line-height: 1.5em;
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: break-word;
    white-space: normal;
    display: flex;
    gap: 10px;
    font-size: 14px;
  }

  .user {
    background: linear-gradient(to right, #3797f7, #001a33);
    color: #ffffff;
    align-self: flex-end;
    margin-left: auto;
    border: 1px solid #4accff;
    animation: messageInRight 0.3s ease-out;
  }

  .bot {
    background-color: #e6ecf2;
    color: #001a33;
    align-self: flex-start;
    margin-right: auto;
    border: 1px solid #4accff;
    animation: messageInLeft 0.3s ease-out;
  }

  .bot img.avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .bot .text {
    text-align: left;
    flex: 1;
  }

  #chat-input {
    display: flex;
    border-top: 1px solid #003366;
    background-color: #d9e3f0;
  }

  #user-input {
    flex: 1;
    padding: 12px;
    border: none;
    background-color: #ffffff;
    color: #001a33;
    font-size: 14px;
    outline: none;
  }

  #chat-input button {
    background-color: #003366;
    border: none;
    color: #ffffff;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 16px;
  }

  /* Pontinhos Digitando */
  .typing-indicator {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 10px 0;
    padding: 10px 14px;
    border-radius: 12px;
    background-color: #e6ecf2;
    border: 1px solid #003366;
    color: #001a33;
  }

  .typing-indicator .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #003366;
    animation: blink 1.4s infinite both;
  }

  .typing-indicator .dot:nth-child(2) {
    animation-delay: 0.2s;
  }
  .typing-indicator .dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
  }
</style>
